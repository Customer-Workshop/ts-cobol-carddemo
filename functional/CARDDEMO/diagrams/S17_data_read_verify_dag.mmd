flowchart BT
  subgraph W1["Wave 1 - seams and utility (leaves)"]
    VSAM["VSAM KSDS read seams\nACCTFILE / CARDFILE / XREFFILE / CUSTFILE\n-> Postgres repositories (B-009)"]
    PSOUT["PS output seam\nPSCOMP 107 FB / ARRYPS 110 FB / VBPS 84 VB\n-> flat files under output dir (B-010)"]
    SYSOUT["SYSOUT report seam\nDISPLAY record dumps -> job log"]
    DE["COBDATFT assembler date-edit\napp/asm/COBDATFT.asm -> util/DateEditService (B-003)"]
    ABEND["CEE3ABD abend seam\nABCODE 999 -> step failure exit code (B-004)"]
  end
  subgraph W2["Wave 2 - multi-output verify job"]
    A1["CBACT01C (READACCT STEP05)\nREADACCT.jcl:32\nreads ACCTFILE, writes 3 PS outputs"]
  end
  subgraph W3["Wave 3 - single-file verify jobs"]
    A2["CBACT02C (READCARD STEP05)\nREADCARD.jcl:22\ndump CARDFILE to SYSOUT"]
    A3["CBACT03C (READXREF STEP05)\nREADXREF.jcl:22\ndump XREFFILE to SYSOUT"]
    C1["CBCUS01C (READCUST STEP05)\nREADCUST.jcl:21\ndump CUSTFILE to SYSOUT"]
  end
